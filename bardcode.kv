            #     allow_stretch: True
                
                #keep_ratio: False
        Button:
            text: "Inv"
            #size: "40dp","40dp"
            #size_hint:None,.2
            on_press: app.hide_widget(scrollViewStats,dohide=True);app.hide_widget(scrollViewQuests,dohide=True);app.hide_widget(scrollViewInv,dohide=False)
            # on_press: StackLayoutExampleID.do_layout(self);app.on_inv_button_click();app.hide_widget(Label1,dohide=False)
            #on_press: app.on_inv_button_click()
            value: "Inv"
        Button:
            text: "Quests"
            #size: "40dp","40dp"
            #size_hint:None,.2
            value: "Quests"
            # on_press: StackLayoutExampleID.do_layout(self);app.on_quests_button_click();print(Label1.size);app.hide_widget(Label1,dohide=True)
            on_press: app.on_quests_button_click();app.hide_widget(scrollViewInv,dohide=True);app.hide_widget(scrollViewStats,dohide=True);app.hide_widget(scrollViewQuests,dohide=False)
            # scrollViewMenus.do_layout(self);
        Button:
            text: "COG"
            size: "40dp","40dp"
            size_hint:1,None
            value: "Settings"
            # on_press: StackLayoutExampleID.clear_widgets();print(app.activeMenu)
            on_press: print(app.activeMenu)

    Label:
