            text: "Stats"
            id: Stats
            #size: "40dp","40dp"
            #size_hint:None,None
            value: "Stats"
            # on_press: StackLayoutExampleID.do_layout(self);app.on_stats_button_click();app.hide_widget(Label1,dohide=False);root.stats_pressed()
            on_release: root.stats_released()
            on_press: app.hide_widget(scrollViewStats,dohide=False);app.hide_widget(scrollViewQuests,dohide=True);app.hide_widget(scrollViewInv,dohide=True)

            # Image:
