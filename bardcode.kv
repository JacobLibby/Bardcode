<AnchorLayoutExample>:
    # right, left, center
    anchor_x: "center"
    # bottom, top, center
    anchor_y: "top"
    BoxLayout:
        size_hint: .1,.1
        Button:
            text: "A"
        Button:
            text: "B"

<BoxLayoutExample>:
    font_name: "fonts/ofont.ru_Fixedsys.ttf" 
    orientation: "vertical"
