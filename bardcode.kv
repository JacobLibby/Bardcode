<MyLayout>:
    BoxLayout:
        orientation: "vertical"
        size: root.width, root.height

        padding: 50
        spacing: 20

        Button:
            text: "Hello World!"
            on_press:print("hi")

        RoundedButton:
            text: "Goodbye World!"
            pos_hint:{'center_x':0.5}
            size_hint:(1,.3)
            #background_color:(48/255,84/255,150/255,1)
            #background_normal: ''





<RoundedButton@Button>
    background_color: (0,0,0,0)
    background_normal: ''
    canvas.before:
        Color:
            rgba:(48/255,84/255,150/255,1)
        RoundedRectangle:
            size: self.size
            pos: self.pos
            radius: [40]
    on_press:print('bye')


<CustomLabel@Label>:
    text_size: root.width, None
    size: self.texture_size
    valign: 'center'
    halign: 'right'

<CustomButton>:
    color: 0, 0, 0, 1    # black color text

    orientation: 'vertical'
    canvas.before:
        Rectangle:
            size: self.size
            pos: self.pos

    size_hint: 1, None
    height: 200
    padding: 5, 5, 5, 5

    background_color: [0.50196, 0.50196, 0.50196, 1] if self.state == 'normal' else [0, 1, 1, 1]

    AnchorLayout:
        canvas.before:
            Color:
                rgba: [1, 1, 1, 1] if root.background_color is None else root.background_color
            Rectangle:
                size: self.size
                pos: self.pos

        AnchorLayout:
            anchor_x: 'left'
            anchor_y: 'center'
            CustomLabel:
                text: root.route
                color: root.color
                halign: 'left'

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            CustomLabel:
                text: root.stations
                color: root.color
                halign:'center'  
        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            CustomLabel:
                text: root.stations
                color: root.color
                halign:'right'  

    AnchorLayout:
        canvas.before:
            Color:
                rgba: [1, 1, 1, 1] if root.background_color is None else root.background_color
            Rectangle:
                size: self.size
                pos: self.pos
        anchor_x: 'right'
        anchor_y: 'center'

        CustomLabel:
            text: root.commute
            color: root.color

<basicTemplate>:
    BoxLayoutExample:


<WidgetExample>:
    cols: 3
    ToggleButton:
        text: "OFF"
        on_state: root.on_toggle_button_state(self)
        font_size: "40dp"
        color: 1,0,0,1
        font_name: "fonts/ofont.ru_Fixedsys.ttf"
        size_hint: None,1
        width: "100dp"

    Button:
        text: "Click Here!"
        on_press: root.on_button_click()
        disabled: not root.count_enabled

    Label:
        font_name: "fonts/ofont.ru_Fixedsys.ttf" 
        text: root.my_text
        font_size: "40dp"
        color: 1,0,0,1

    Switch:
        id: my_switch
        width: "100dp"
        size_hint: None,1
        on_active: root.on_switch_active(self)
        active: True

    Slider:
        id: my_slider
        min: 0
        max: 100
        step: 1
        #on_touch_up: root.on_slider_touch_up(self)
        #on_value: root.on_slider_value(self)
        value: 50
        disabled: not my_switch.active
        #orientation: "vertical"
    BoxLayout:
        orientation: "vertical"
        Label:
            text: str(int(my_slider.value))
        ProgressBar:
            value: my_slider.value
            max: 100
    TextInput:
        id: my_text_input
        font_name: "fonts/ofont.ru_Fixedsys.ttf"
        size_hint: None,1
        width: "100dp"
        suggestion: "foo"
        multiline: False
        on_text_validate: root.on_text_validate(self)
    Label:
        text: root.validated_text

