                font_name: "fonts/ofont.ru_Fixedsys.ttf" 
                text: root.validated_text
                font_size: "40dp"
                text_size: self.width, None
                size_hint: 1,None
                height: self.texture_size[1]
                color: 1,1,1,1
                halign: "center"
                padding_x:40
                markup: True
        
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "bottom"
            
            BoxLayout:
                size_hint: (1, 0.5)
                spacing: 50
                spacing_bottom:"100dp"
                orientation:'horizontal'

