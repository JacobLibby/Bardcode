                    text_size: self.width, None
                    size_hint_y: None
                    halign:'center'
                    valign:'center'
                    height: self.texture_size[1]
                    pos:(20,20)
                    # size_hint: None,None
                    size_hint: .3,.5
                    markup: True
                    # width: self.texture_size[0]

                    # height: self.texture_size[1]
