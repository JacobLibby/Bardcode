
BoxLayoutExample:

<IconButton>:
#    size_hint:(1,1)
    size_hint:None,None
    height:"200dp"
    width:"500dp"
    color:0,.5,0,1
    on_press: print('on_press')
    padding:5,5,5,5
    GridLayout:
        size_hint:(1,1)
        cols:3
        MyLabel:
            text: "icon"
            size_hint:(.3,1)
            color:1,0,0,1
            background_color:0,.5,.5,1
        Label:
            text: "test2"
            size_hint:(.4,1)
            color:1,0,0,1
        Label:
            text: "test3"
            size_hint:(.3,1)
            color:1,0,0,1

<CustomLabel@Label>:
    text_size: root.width, None
    size: self.texture_size
    valign: 'center'
    halign: 'right'

<CustomButton>:
    color: 0, 0, 0, 1    # black color text

    orientation: 'vertical'
    canvas.before:
        Rectangle:
            size: self.size
            pos: self.pos

    size_hint: 1, None
    height: 200
    padding: 5, 5, 5, 5

    background_color: [0.50196, 0.50196, 0.50196, 1] if self.state == 'normal' else [0, 1, 1, 1]

    AnchorLayout:
        canvas.before:
            Color:
                rgba: [1, 1, 1, 1] if root.background_color is None else root.background_color
            Rectangle:
                size: self.size
                pos: self.pos

        AnchorLayout:
            anchor_x: 'left'
            anchor_y: 'center'
            CustomLabel:
                text: root.route
                color: root.color
                halign: 'left'

        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            CustomLabel:
                text: root.stations
                color: root.color
                halign:'center'  
        AnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            CustomLabel:
                text: root.stations
                color: root.color
                halign:'right'  

    AnchorLayout:
        canvas.before:
            Color:
                rgba: [1, 1, 1, 1] if root.background_color is None else root.background_color
            Rectangle:
                size: self.size
                pos: self.pos
        anchor_x: 'right'
        anchor_y: 'center'

        CustomLabel:
            text: root.commute
            color: root.color

<basicTemplate>:
    BoxLayoutExample:


<WidgetExample>:
    cols: 3
    ToggleButton:
        text: "OFF"
        on_state: root.on_toggle_button_state(self)
        font_size: "40dp"
        color: 1,0,0,1
        font_name: "fonts/ofont.ru_Fixedsys.ttf"
        size_hint: None,1
        width: "100dp"

    Button:
        text: "Click Here!"
        on_press: root.on_button_click()
        disabled: not root.count_enabled

    Label:
        font_name: "fonts/ofont.ru_Fixedsys.ttf" 
        text: root.my_text
        font_size: "40dp"
        color: 1,0,0,1

    Switch:
        id: my_switch
        width: "100dp"
        size_hint: None,1
        on_active: root.on_switch_active(self)
        active: True

    Slider:
        id: my_slider
        min: 0
        max: 100
        step: 1
        #on_touch_up: root.on_slider_touch_up(self)
        #on_value: root.on_slider_value(self)
        value: 50
        disabled: not my_switch.active
        #orientation: "vertical"
    BoxLayout:
        orientation: "vertical"
        Label:
            text: str(int(my_slider.value))
        ProgressBar:
            value: my_slider.value
            max: 100
    TextInput:
        id: my_text_input
        font_name: "fonts/ofont.ru_Fixedsys.ttf"
        size_hint: None,1
        width: "100dp"
        suggestion: "foo"
        multiline: False
        on_text_validate: root.on_text_validate(self)
    Label:
        text: root.validated_text

<PageLayoutExample>:
    MainWidget:
    BoxLayoutExample:
    AnchorLayoutExample:
    GridLayoutExample:

<ScrollViewExample>:
    StackLayoutExample:
        size_hint:1,None
        height:self.minimum_height

