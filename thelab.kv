<GridLayoutExample@GridLayout>:
    # NEED to specify either "rows" and/or "cols"
    cols: 3
    Button:
        text: "A"
        size_hint:None,1
        width:"60dp"
    Button:
        text: "B"
        size_hint: .5,1
    BoxLayoutExample:

    Button:
        text: "D"
        size_hint:None,1
        width:"60dp"
    Button:
        text: "E"
        size_hint: .5,1
    Button:
        text: "F"
<IconButton>:
    on_press: print('on_press')

<AnchorLayoutExample>:
    # right, left, center
    anchor_x: "center"
    # bottom, top, center
    anchor_y: "top"
    BoxLayout:
        size_hint: .1,.1
        Button:
            text: "A"
        Button:
            text: "B"
<BoxLayoutExample>:
    font_name: "fonts/ofont.ru_Fixedsys.ttf" 
    orientation: "vertical"
    RelativeLayout:
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "top"
            BoxLayout:
                size_hint: .1,.1
                Button:
                    text: "A"
                Button:
                    text: "B"
        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"
            Label:
                spacing:5,5,5,5
                font_name: "fonts/ofont.ru_Fixedsys.ttf" 
                text: root.validated_text
                font_size: "40dp"
                text_size: self.width, None
                size_hint: 1,None
                height: self.texture_size[1]
                color: 1,1,1,1
                halign: "center"
                padding_x:40
                markup: True

    TextInput:
        id: my_text_input
        font_name: "fonts/ofont.ru_Fixedsys.ttf"
        suggestion: "foo"
        multiline: False
        on_text_validate: root.on_text_validate(self)
        #size: 100,"60dp"
        #size_hint: 1, None
        size:"100dp","60dp"
        size_hint: .8,None
        pos_hint: {"center_x":.5}
    BoxLayout:
        BoxLayout:
            spacing:"5dp"
            size:"80dp","100dp"
            size_hint:None,1
            orientation: "vertical"
            Button:
                text: "Stats"
                #size: "40dp","40dp"
                #size_hint:None,None
                value: "Stats"
                on_press: StackLayoutExampleID.do_layout(self)
            Button:
                text: "Inv"
                #size: "40dp","40dp"
                #size_hint:None,.2
                on_press: StackLayoutExampleID.do_layout(self)
                #on_press: app.on_inv_button_click()
                value: "Inv"
            Button:
                text: "Quests"
                #size: "40dp","40dp"
                #size_hint:None,.2
                value: "Quests"
                on_press: StackLayoutExampleID.do_layout(self)
            Button:
                text: "COG"
                size: "40dp","40dp"
                size_hint:1,None
                value: "Settings"
                on_press: StackLayoutExampleID.clear_widgets()
        ScrollView:
            id: scrollviewID
            StackLayoutExample:
                id: StackLayoutExampleID
                size_hint:1,None
                height:self.minimum_height



<MainWidget>:
    Button:
        text: "Hello"
        size: "100dp","80dp"
        pos: "200dp","300dp"
        color: 0,0,1,1

    Label:
        text: "Hello2"
        size: "100dp","80dp"
        pos: "200dp","300dp"
        color: 1,0,0,1


<ImageExample@GridLayout>:
    cols: 3
    Image:
        source: "images/cake.jpg"
    Image:
        source: "images/cake.jpg"
        allow_stretch: True
    Image:
        source: "images/cake.jpg"
        allow_stretch: True
        keep_ratio: False
